---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';

interface Props {
  project: Project;
  play: 'hover' | 'scroll' | 'auto';
  index?: number;
}

const { project, play, index = 0 } = Astro.props;
const lazyVideo = index > 0 && !!project.video && !!project.video.poster;
---

<span class="slot__media" data-reveal="wipe">
  {
    project.video && lazyVideo ? (
      <img
        src={publicUrl(project.video.poster)}
        alt={project.video.label}
        loading="lazy"
        decoding="async"
        width={project.video.width}
        height={project.video.height}
        data-video-src={publicUrl(project.video.src)}
        data-video-webm={project.video.webm ? publicUrl(project.video.webm) : undefined}
        data-play={play}
      />
    ) : project.video ? (
      <video
        class="slot__v"
        poster={project.video.poster ? publicUrl(project.video.poster) : undefined}
        muted
        loop
        playsinline
        autoplay={play === 'auto'}
        preload={play === 'hover' ? 'metadata' : play === 'auto' ? 'auto' : 'none'}
        width={project.video.width}
        height={project.video.height}
        aria-label={project.video.label}
        data-play={play}
      >
        {project.video.webm && <source src={publicUrl(project.video.webm)} type="video/webm" />}
        <source src={publicUrl(project.video.src)} type="video/mp4" />
      </video>
    ) : (
      project.cover && (
        <img
          src={publicUrl(project.cover.src)}
          alt={project.cover.alt}
          loading="lazy"
          decoding="async"
          width={project.cover.width}
          height={project.cover.height}
        />
      )
    )
  }
</span>
<span class="ph">
  <span class="ph__file">{project.title}</span>
</span>
