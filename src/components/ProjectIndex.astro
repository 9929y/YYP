---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';
import ProjectSlot from './ProjectSlot.astro';
import CaseNoteGenerate from './islands/CaseNoteGenerate';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.map((project, index) => (
    <article
      class="case row row--ruled"
      data-motion-case={String(index)}
      data-case-theme={project.theme}
      data-reveal="text"
      data-reveal-sync="case"
    >
      <div class="case__label">
        <CaseNoteGenerate client:visible text={project.note} />
        <div class="case__meta">
          {project.logo && (
            <img
              class="case__logo"
              src={publicUrl(project.logo.src)}
              alt={project.logo.alt}
              width={project.logo.width}
              height={project.logo.height}
              loading="lazy"
            />
          )}
          <h2 class="case__name">{project.headline ?? project.title}</h2>
          <p class="case__scope">{project.scope}</p>
        </div>
      </div>
      <ProjectSlot project={project} />
    </article>
  ))
}
