---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';
import ProjectSlot from './ProjectSlot.astro';
import CaseNoteGenerate from './islands/CaseNoteGenerate';
import MaskedTextReveal from './islands/MaskedTextReveal';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.map((project, index) => (
    <article
      class="case row row--ruled"
      data-motion-case={String(index)}
      data-case-theme={project.theme}
    >
      <div class="case__label">
        <CaseNoteGenerate client:visible text={project.note} />
        <div class="case__meta">
          {project.logo && (
            <img
              class="case__logo"
              src={publicUrl(project.logo.src)}
              alt={project.logo.alt}
              width={project.logo.width}
              height={project.logo.height}
              loading="lazy"
            />
          )}
          <MaskedTextReveal
            client:visible
            as="h2"
            className="case__name"
            splitBy="words"
            text={project.headline ?? project.title}
          />
          <MaskedTextReveal
            client:visible
            as="p"
            className="case__scope"
            splitBy="lines"
            delay={0.12}
            text={project.scope}
          />
        </div>
      </div>
      <ProjectSlot project={project} />
    </article>
  ))
}
