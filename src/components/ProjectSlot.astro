---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.href ? publicUrl(project.href) : undefined;
const label = `${project.title} case study`;
---

{
  project.kind === 'panel' ? (
    <div class="panel rv" style="counter-reset: act">
      <ul class="panel__acts">
        {project.acts?.map((act) => <li>{act}</li>)}
      </ul>
      {project.panelFoot && <p class="panel__foot">{project.panelFoot}</p>}
    </div>
  ) : href ? (
    <a class="slot rv" href={href} aria-label={label}>
      {project.video ? (
        <video
          class="slot__v"
          poster={publicUrl(project.video.poster)}
          muted
          loop
          playsinline
          preload="none"
          width={project.video.width}
          height={project.video.height}
          aria-label={project.video.label}
        >
          <source src={publicUrl(project.video.src)} type="video/mp4" />
        </video>
      ) : (
        project.cover && (
          <img
            src={publicUrl(project.cover.src)}
            alt={project.cover.alt}
            loading="lazy"
            width={project.cover.width}
            height={project.cover.height}
          />
        )
      )}
      <span class="ph">
        <span class="ph__file">{project.placeholderFile}</span>
        <span class="ph__spec">{project.placeholderSpec}</span>
      </span>
    </a>
  ) : null
}
