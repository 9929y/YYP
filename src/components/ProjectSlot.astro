---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';
import SlotMedia from './SlotMedia.astro';

interface Props {
  project: Project;
  /** First landing case: eager poster + video preload=metadata. */
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const href = project.href ? publicUrl(project.href) : undefined;
const label = `${project.title} case study`;
const play = project.video?.play ?? 'scroll';
const showMedia = project.kind !== 'panel' && !!(project.video || project.cover);
---

{
  project.kind === 'panel' ? (
    <div class="panel" style="counter-reset: act">
      <ul class="panel__acts">
        {project.acts?.map((act) => <li>{act}</li>)}
      </ul>
      {project.panelFoot && <p class="panel__foot">{project.panelFoot}</p>}
    </div>
  ) : showMedia && href ? (
    <a class="slot" href={href} aria-label={label} data-cursor-label="view">
      <SlotMedia project={project} play={play} priority={priority} />
    </a>
  ) : showMedia ? (
    <div
      class:list={['slot', 'slot--static']}
      role="group"
      aria-label={project.title}
      data-cursor-label={project.status === 'in-progress' ? 'in progress' : undefined}
      data-cursor-chip={project.status === 'in-progress' ? 'true' : undefined}
      data-status={project.status}
    >
      <SlotMedia project={project} play={play} priority={priority} />
    </div>
  ) : null
}
