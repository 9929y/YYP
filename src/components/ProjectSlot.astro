---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.href ? publicUrl(project.href) : undefined;
const label = `${project.title} case study`;
const play = project.video?.play ?? 'scroll';
const showMedia = project.kind !== 'panel' && !!(project.video || project.cover);
/* Opus Clip only: frosted-glass card frame, Figma node 37:688. */
const isGlass = project.slug === 'ai-driven-product-design';
const videoType = (src: string) => (src.endsWith('.webm') ? 'video/webm' : 'video/mp4');
---

{
  project.kind === 'panel' ? (
    <div class="panel rv" style="counter-reset: act">
      <ul class="panel__acts">
        {project.acts?.map((act) => <li>{act}</li>)}
      </ul>
      {project.panelFoot && <p class="panel__foot">{project.panelFoot}</p>}
    </div>
  ) : showMedia && href ? (
    <a class={`slot rv${isGlass ? ' slot--glass' : ''}`} href={href} aria-label={label}>
      <span class="slot__window">
        {project.video ? (
          <video
            class="slot__v"
            poster={project.video.poster ? publicUrl(project.video.poster) : undefined}
            muted
            loop
            playsinline
            preload={play === 'hover' ? 'metadata' : 'none'}
            width={project.video.width}
            height={project.video.height}
            aria-label={project.video.label}
            data-play={play}
          >
            <source src={publicUrl(project.video.src)} type={videoType(project.video.src)} />
          </video>
        ) : (
          project.cover && (
            <img
              src={publicUrl(project.cover.src)}
              alt={project.cover.alt}
              loading="lazy"
              width={project.cover.width}
              height={project.cover.height}
            />
          )
        )}
        <span class="ph">
          <span class="ph__file">{project.placeholderFile}</span>
          <span class="ph__spec">{project.placeholderSpec}</span>
        </span>
      </span>
    </a>
  ) : showMedia ? (
    <div class="slot slot--static rv" role="group" aria-label={project.title}>
      {project.video ? (
        <video
          class="slot__v"
          poster={project.video.poster ? publicUrl(project.video.poster) : undefined}
          muted
          loop
          playsinline
          preload={play === 'hover' ? 'metadata' : 'none'}
          width={project.video.width}
          height={project.video.height}
          aria-label={project.video.label}
          data-play={play}
        >
          <source src={publicUrl(project.video.src)} type={videoType(project.video.src)} />
        </video>
      ) : (
        project.cover && (
          <img
            src={publicUrl(project.cover.src)}
            alt={project.cover.alt}
            loading="lazy"
            width={project.cover.width}
            height={project.cover.height}
          />
        )
      )}
      <span class="ph">
        <span class="ph__file">{project.placeholderFile}</span>
        <span class="ph__spec">{project.placeholderSpec}</span>
      </span>
    </div>
  ) : null
}
