---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.href ? publicUrl(project.href) : undefined;
const label = `${project.title} case study`;
const play = project.video?.play ?? 'scroll';
const showMedia = project.kind !== 'panel' && !!(project.video || project.cover);
---

{
  project.kind === 'panel' ? (
    <div class="panel rv" data-reveal="text" style="counter-reset: act">
      <ul class="panel__acts">
        {project.acts?.map((act) => <li>{act}</li>)}
      </ul>
      {project.panelFoot && <p class="panel__foot">{project.panelFoot}</p>}
    </div>
  ) : showMedia && href ? (
    <a class="slot rv" data-reveal="media" href={href} aria-label={label} data-cursor-label="view">
      {project.video ? (
        <video
          class="slot__v"
          poster={project.video.poster ? publicUrl(project.video.poster) : undefined}
          muted
          loop
          playsinline
          preload={play === 'hover' ? 'metadata' : 'none'}
          width={project.video.width}
          height={project.video.height}
          aria-label={project.video.label}
          data-play={play}
        >
          <source src={publicUrl(project.video.src)} type="video/mp4" />
        </video>
      ) : (
        project.cover && (
          <img
            src={publicUrl(project.cover.src)}
            alt={project.cover.alt}
            loading="lazy"
            width={project.cover.width}
            height={project.cover.height}
          />
        )
      )}
      <span class="ph">
        <span class="ph__file">{project.placeholderFile}</span>
        <span class="ph__spec">{project.placeholderSpec}</span>
      </span>
    </a>
  ) : showMedia ? (
    <div
      class:list={['slot', 'slot--static', 'rv']}
      data-reveal="media"
      role="group"
      aria-label={project.title}
      data-cursor-label={project.status === 'in-progress' ? 'on progress' : undefined}
      data-cursor-chip={project.status === 'in-progress' ? 'true' : undefined}
      data-status={project.status}
    >
      {project.video ? (
        <video
          class="slot__v"
          poster={project.video.poster ? publicUrl(project.video.poster) : undefined}
          muted
          loop
          playsinline
          preload={play === 'hover' ? 'metadata' : 'none'}
          width={project.video.width}
          height={project.video.height}
          aria-label={project.video.label}
          data-play={play}
        >
          <source src={publicUrl(project.video.src)} type="video/mp4" />
        </video>
      ) : (
        project.cover && (
          <img
            src={publicUrl(project.cover.src)}
            alt={project.cover.alt}
            loading="lazy"
            width={project.cover.width}
            height={project.cover.height}
          />
        )
      )}
      <span class="ph">
        <span class="ph__file">{project.placeholderFile}</span>
        <span class="ph__spec">{project.placeholderSpec}</span>
      </span>
    </div>
  ) : null
}
