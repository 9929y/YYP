---
import type { Project } from '../data/projects';
import { publicUrl } from '../data/projects';

interface Props {
  prev?: Project;
  next?: Project;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="cs__nav" aria-label="Adjacent case studies">
    {prev?.href ? (
      <a href={publicUrl(prev.href)}>
        <span class="cs__nav-dir">Previous</span>
        {prev.title}
      </a>
    ) : <span />}
    {next?.href ? (
      <a href={publicUrl(next.href)} style="text-align: right">
        <span class="cs__nav-dir">Next</span>
        {next.title}
      </a>
    ) : <span />}
  </nav>
)}
