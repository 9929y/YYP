---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseMetaGrid from '../components/CaseMetaGrid.astro';
import CaseQuote from '../components/CaseQuote.astro';
import CaseSection from '../components/CaseSection.astro';
import CaseStat from '../components/CaseStat.astro';
import type { Project } from '../data/projects';

/** Review-only Foundation surface. Not linked from navigation; noindex. */
const project: Project = {
  slug: 'case-study-template',
  title: 'Case Study Foundation',
  href: 'case-study-template.html',
  scope: 'Foundation · Review',
  note: 'Template used to review Astro case-study components before publishing a real case.',
  description: 'Internal Foundation review surface for Astro case-study components.',
  status: 'in-progress',
  engine: 'astro',
  kind: 'slot',
  theme: 'dark',
  featuredOnLanding: false,
  featuredOnIndex: false,
  featuredOnProjects: false,
  landingOrder: 99,
  cover: {
    src: 'assets/images/home/case-opusclip.jpg',
    alt: 'Case study foundation review cover',
    width: 492,
    height: 369
  }
};
---

<CaseStudyLayout project={project} noindex={true}>
  <CaseMetaGrid
    overview={project.note}
    role="Product design"
    timeline="Template"
  />

  <CaseSection id="evidence" eyebrow="01" title="Evidence">
    <p>Replace this section with the project’s strongest evidence artifact.</p>
  </CaseSection>

  <CaseSection id="decision" eyebrow="02" title="Decision">
    <CaseQuote quote={project.note} attribution="Foundation · Review" />
  </CaseSection>

  <CaseSection id="outcome" eyebrow="03" title="Outcome">
    <div class="case-stat-grid">
      <CaseStat value="—" label="Primary outcome" />
      <CaseStat value="—" label="Supporting outcome" />
    </div>
  </CaseSection>
</CaseStudyLayout>
