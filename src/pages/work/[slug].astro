---
/**
 * PLACEHOLDER case-study route. Renders the extracted Markdown as-is so the
 * copy can be reviewed at /work/<slug>. The Figma UI replaces this template.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import nav from '@/content/site/navigation.json';

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const order = nav.caseOrder;
const i = order.indexOf(entry.data.slug);
const prev = i > 0 ? order[i - 1] : null;
const next = i >= 0 && i < order.length - 1 ? order[i + 1] : null;
---

<BaseLayout title={`${entry.data.title} — Yanice Yang`} description={entry.data.description ?? entry.data.note}>
  <article class="mx-auto max-w-3xl px-6 py-24">
    <header class="mb-16">
      <p class="text-sm uppercase tracking-wide text-muted-foreground">{entry.data.scope}</p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight">{entry.data.headline ?? entry.data.title}</h1>
      <p class="mt-4 text-lg text-muted-foreground">{entry.data.note}</p>
    </header>

    <div
      class="space-y-6 leading-relaxed
        [&_h1]:text-3xl [&_h1]:font-semibold [&_h1]:mt-16
        [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-14
        [&_h3]:text-xl [&_h3]:font-medium [&_h3]:mt-10
        [&_img]:rounded-lg [&_img]:border [&_video]:rounded-lg [&_video]:border [&_video]:w-full
        [&_iframe]:w-full [&_iframe]:aspect-[9/16] [&_iframe]:rounded-lg
        [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6
        [&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:pl-4 [&_blockquote]:italic"
    >
      <Content />
    </div>

    <nav class="mt-24 flex justify-between border-t pt-8 text-sm" aria-label="Case studies">
      {prev ? <a href={`/work/${prev}`}>← {nav.footer.prevLabel}</a> : <span />}
      {next ? <a href={`/work/${next}`}>{nav.footer.nextLabel} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
