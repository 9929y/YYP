---
/** PLACEHOLDER work index. Cards come from src/content/pages/work.md frontmatter. */
import { getEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';

const work = await getEntry('pages', 'work');
if (!work) throw new Error('src/content/pages/work.md is missing');
const cards = work.data.cards ?? [];
---

<PageLayout title={`${work.data.title} — Yanice Yang`} description={work.data.description}>
  <main class="mx-auto max-w-6xl px-6 py-24">
    <h1 class="text-4xl font-semibold">{work.data.title}</h1>
    <ul class="mt-12 grid gap-8 sm:grid-cols-2">
      {cards.map((card) => (
        <li>
          <article class:list={['group', card.comingSoon && 'opacity-60']}>
            <div class="aspect-[4/3] overflow-hidden rounded-xl border bg-muted">
              <img
                src={card.cover}
                alt=""
                loading="lazy"
                class="h-full w-full object-cover"
                style={card.coverPosition ? `object-position:${card.coverPosition}` : undefined}
              />
            </div>
            <h2 class="mt-4 text-lg font-medium">
              {card.href && !card.comingSoon ? <a href={card.href}>{card.title}</a> : card.title}
            </h2>
            <p class="text-sm text-muted-foreground">{card.subtitle}</p>
          </article>
        </li>
      ))}
    </ul>
  </main>
</PageLayout>
