---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseMetaGrid from '../components/CaseMetaGrid.astro';
import CaseQuote from '../components/CaseQuote.astro';
import CaseSection from '../components/CaseSection.astro';
import CaseStat from '../components/CaseStat.astro';
import MediaFigure from '../components/MediaFigure.astro';
import MediaVideo from '../components/MediaVideo.astro';
import { astroCaseStudies, getProject } from '../data/projects';
import { getCaseStudyContent } from '../data/case-studies';

export function getStaticPaths() {
  return astroCaseStudies()
    .filter((project) => getCaseStudyContent(project.slug))
    .map((project) => ({
      params: { slug: project.slug.replace(/\.html$/, '') }
    }));
}

const project = getProject(Astro.params.slug);
if (!project) {
  throw new Error(`Unknown Astro case study: ${Astro.params.slug}`);
}
const content = getCaseStudyContent(project.slug);
if (!content) {
  throw new Error(`Missing Astro case-study content: ${project.slug}`);
}
---

<CaseStudyLayout project={project}>
  <CaseMetaGrid
    overview={content.meta.overview}
    role={content.meta.role}
    timeline={content.meta.timeline}
  />

  {content.sections.map((section) => (
    <CaseSection id={section.id} eyebrow={section.eyebrow} title={section.title}>
      {section.body.map((paragraph) => <p>{paragraph}</p>)}
      {section.media?.map((media) => (
        media.type === 'video' ? (
          <MediaVideo
            src={media.src}
            poster={media.poster}
            label={media.label ?? media.caption ?? project.title}
            width={media.width ?? 1440}
            height={media.height ?? 1080}
            caption={media.caption}
          />
        ) : (
          <MediaFigure
            src={media.src}
            alt={media.alt ?? media.caption ?? project.title}
            width={media.width}
            height={media.height}
            caption={media.caption}
          />
        )
      ))}
    </CaseSection>
  ))}

  {content.quote && <CaseQuote quote={content.quote.quote} attribution={content.quote.attribution} />}

  {content.stats && content.stats.length > 0 && (
    <CaseSection id="outcome" eyebrow="Outcome" title="Signals">
      <div class="case-stat-grid">
        {content.stats.map((stat) => <CaseStat value={stat.value} label={stat.label} />)}
      </div>
    </CaseSection>
  )}
</CaseStudyLayout>
