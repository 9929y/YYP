---
/**
 * Scaffold route for `engine: 'astro'` case studies that do not yet have a
 * hand-written page.
 *
 * Migrated case studies each get their own `src/pages/<slug>.astro`, because the
 * real pages are visually bespoke — different heroes, different section rhythms.
 * This route must therefore yield to them: without the DEDICATED filter below,
 * flipping a project to `engine: 'astro'` makes both this route and its own page
 * emit the same filename, and one silently overwrites the other. That happened
 * once, on alzheimerdisease, and shipped the placeholder copy over the real page.
 *
 * The placeholder body below is live the moment a project is `engine: 'astro'` +
 * `published` + has an `href` and has no dedicated page. check-site.mjs fails the
 * build if either placeholder string reaches dist.
 */
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseMetaGrid from '../components/CaseMetaGrid.astro';
import CaseQuote from '../components/CaseQuote.astro';
import CaseSection from '../components/CaseSection.astro';
import CaseStat from '../components/CaseStat.astro';
import MediaFigure from '../components/MediaFigure.astro';
import MediaVideo from '../components/MediaVideo.astro';
import { astroCaseStudies, getProject } from '../data/projects';

export function getStaticPaths() {
  // Slugs that own a hand-written page in this directory. Vite resolves the glob
  // at build time, so the list can never drift from the files actually present.
  // Astro hoists getStaticPaths out of frontmatter scope, so this is computed
  // here rather than in a module-level const.
  const dedicated = new Set(
    Object.keys(import.meta.glob('./*.astro'))
      .map((file) => file.replace(/^\.\//, '').replace(/\.astro$/, ''))
      .filter((name) => !name.startsWith('['))
  );

  return astroCaseStudies()
    .filter((project) => !dedicated.has(project.slug))
    .map((project) => ({
      params: { slug: project.slug.replace(/\.html$/, '') }
    }));
}

const project = getProject(Astro.params.slug);
if (!project) {
  throw new Error(`Unknown Astro case study: ${Astro.params.slug}`);
}
---

<CaseStudyLayout project={project}>
  <CaseMetaGrid
    overview={project.note}
    role={project.scope}
    timeline={project.status === 'published' ? 'Published case study' : 'In progress'}
  />

  <CaseSection id="evidence" eyebrow="01" title="Evidence">
    {project.video ? (
      <MediaVideo
        src={project.video.src}
        poster={project.video.poster}
        label={project.video.label}
        width={project.video.width}
        height={project.video.height}
      />
    ) : project.cover ? (
      <MediaFigure
        src={project.cover.src}
        alt={project.cover.alt}
        width={project.cover.width}
        height={project.cover.height}
      />
    ) : (
      <p>Add the project’s strongest evidence artifact here.</p>
    )}
  </CaseSection>

  <CaseSection id="decision" eyebrow="02" title="Decision">
    <CaseQuote quote={project.note} attribution={`${project.title} · Project summary`} />
  </CaseSection>

  <CaseSection id="outcome" eyebrow="03" title="Outcome">
    <div class="case-stat-grid">
      <CaseStat value="—" label="Primary outcome" />
      <CaseStat value="—" label="Supporting outcome" />
    </div>
  </CaseSection>
</CaseStudyLayout>
