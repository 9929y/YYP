---
/** Scaffold only — replace body sections before publishing any `engine: 'astro'` case. */
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseMetaGrid from '../components/CaseMetaGrid.astro';
import CaseQuote from '../components/CaseQuote.astro';
import CaseSection from '../components/CaseSection.astro';
import CaseStat from '../components/CaseStat.astro';
import MediaFigure from '../components/MediaFigure.astro';
import MediaVideo from '../components/MediaVideo.astro';
import { astroCaseStudies, getProject } from '../data/projects';

export function getStaticPaths() {
  return astroCaseStudies().map((project) => ({
    params: { slug: project.slug.replace(/\.html$/, '') }
  }));
}

const project = getProject(Astro.params.slug);
if (!project) {
  throw new Error(`Unknown Astro case study: ${Astro.params.slug}`);
}
---

<CaseStudyLayout project={project}>
  <CaseMetaGrid
    overview={project.note}
    role={project.scope}
    timeline={project.status === 'published' ? 'Published case study' : 'In progress'}
  />

  <CaseSection id="evidence" eyebrow="01" title="Evidence">
    {project.video ? (
      <MediaVideo
        src={project.video.src}
        poster={project.video.poster}
        label={project.video.label}
        width={project.video.width}
        height={project.video.height}
        caption={project.placeholderSpec}
      />
    ) : project.cover ? (
      <MediaFigure
        src={project.cover.src}
        alt={project.cover.alt}
        width={project.cover.width}
        height={project.cover.height}
        caption={project.placeholderSpec}
      />
    ) : (
      <p>Add the project’s strongest evidence artifact here.</p>
    )}
  </CaseSection>

  <CaseSection id="decision" eyebrow="02" title="Decision">
    <CaseQuote quote={project.note} attribution={`${project.title} · Project summary`} />
  </CaseSection>

  <CaseSection id="outcome" eyebrow="03" title="Outcome">
    <div class="case-stat-grid">
      <CaseStat value="—" label="Primary outcome" />
      <CaseStat value="—" label="Supporting outcome" />
    </div>
  </CaseSection>
</CaseStudyLayout>
