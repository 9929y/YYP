---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about-page.css';
/*
  About page, moved off the exported markup onto Astro.

  Structure is unchanged from what shipped: a two-column hero (intro column +
  circular portrait with a decorative aurora bleeding out of it), a prose block
  with the fashion link, then four alternating story rows.

  Heading levels are the export's own and are already correct: one h1 for the
  name, h2 for "Fun Fact" and "A little about me", h3 per story. "Hello," was a
  div in the export and stays a non-heading here — it is the first half of a
  sentence the h1 completes, not a heading of its own.

  The two SVGs are inline rather than <img> because they are 300 bytes each,
  paint with the surrounding text colour via currentColor, and were inline in
  the export for exactly that reason.
*/

interface Story {
  title: string;
  /* Prose carries <strong> and a hard <br />, so it is HTML rather than text.
     It is authored here and never comes from user input. */
  html: string;
  images: { src: string; srcset: string; sizes: string; alt: string }[];
}

const stories: Story[] = [
  {
    title: 'I am a dog lover!',
    html:
      'I’m a passionate <strong>dog lover</strong> and proud owner of a beautiful black Shiba Inu named <strong>Xiao Kui</strong> (小葵). Since welcoming Xiao Kui into my life last year, I’ve discovered the joy and companionship that comes with being a dog parent. My love for dogs has not only enriched my personal life but also connected me with a wonderful community of fellow dog enthusiasts.<br />As a dog lover, I believe in the power of these loyal companions to bring people together, teach us patience and responsibility, and fill our lives with unconditional love.',
    images: [
      {
        src: '/assets/images/about/photo-pet-photobooth-strip.webp',
        srcset:
          '/assets/images/about/photo-pet-photobooth-strip-p-500.webp 500w, /assets/images/about/photo-pet-photobooth-strip.webp 800w',
        sizes: '(max-width: 800px) 100vw, 800px',
        alt: 'Photobooth strip of a woman in a costume hat posing with two small dogs'
      },
      {
        src: '/assets/images/about/photo-feeding-two-dogs-treat.webp',
        srcset:
          '/assets/images/about/photo-feeding-two-dogs-treat-p-500.webp 500w, /assets/images/about/photo-feeding-two-dogs-treat-p-800.webp 800w, /assets/images/about/photo-feeding-two-dogs-treat-p-1080.webp 1080w, /assets/images/about/photo-feeding-two-dogs-treat-p-1600.webp 1600w, /assets/images/about/photo-feeding-two-dogs-treat-p-2000.webp 2000w, /assets/images/about/photo-feeding-two-dogs-treat-p-2600.webp 2600w, /assets/images/about/photo-feeding-two-dogs-treat-p-3200.webp 3200w, /assets/images/about/photo-feeding-two-dogs-treat.webp 3200w',
        sizes: '(max-width: 4284px) 100vw, 4284px',
        alt: 'Hand offering a piece of baked treat to an excited Shiba Inu and an Australian Shepherd'
      }
    ]
  },
  {
    title: 'I enjoy Skiing;)',
    html:
      'I’m an avid <strong>skiing enthusiast</strong> who finds joy and exhilaration on the slopes. Whether it’s carving through fresh powder, tackling challenging runs, or simply enjoying the breathtaking mountain views, skiing is more than just a sport to me—it’s a way of life.<br />Meet me Vermont or Denver in snow season;)',
    images: [
      {
        src: '/assets/images/about/photo-snowboarder-on-slope-portrait.webp',
        srcset:
          '/assets/images/about/photo-snowboarder-on-slope-portrait-p-500.webp 375w, /assets/images/about/photo-snowboarder-on-slope-portrait-p-800.webp 600w, /assets/images/about/photo-snowboarder-on-slope-portrait-p-1080.webp 810w, /assets/images/about/photo-snowboarder-on-slope-portrait-p-1600.webp 1200w, /assets/images/about/photo-snowboarder-on-slope-portrait-p-2000.webp 1500w, /assets/images/about/photo-snowboarder-on-slope-portrait-p-2600.webp 1950w, /assets/images/about/photo-snowboarder-on-slope-portrait.webp 2400w',
        sizes: '(max-width: 2400px) 100vw, 2400px',
        alt: 'Skier in a purple jacket and helmet standing beside a snowboard on a sunny mountain slope'
      },
      {
        src: '/assets/images/about/photo-ski-resort-gondola-slope.webp',
        srcset:
          '/assets/images/about/photo-ski-resort-gondola-slope-p-500.webp 375w, /assets/images/about/photo-ski-resort-gondola-slope-p-800.webp 600w, /assets/images/about/photo-ski-resort-gondola-slope-p-1080.webp 810w, /assets/images/about/photo-ski-resort-gondola-slope-p-1600.webp 1200w, /assets/images/about/photo-ski-resort-gondola-slope-p-2000.webp 1500w, /assets/images/about/photo-ski-resort-gondola-slope-p-2600.webp 1950w, /assets/images/about/photo-ski-resort-gondola-slope.webp 2400w',
        sizes: '(max-width: 2400px) 100vw, 2400px',
        alt: 'Snowy ski resort seen from the slope'
      }
    ]
  },
  {
    title: 'I am a home cook',
    html:
      'In my kitchen, I enjoy experimenting with fresh ingredients, mastering classic recipes, and putting my own creative spin on dishes. Whether it’s steaming fluffy bao buns, perfecting the art of wok cooking, or hosting friends for a homemade hot pot feast, I find joy in every step of the process. Through cooking, I’ve not only honed my skills but also built a deeper appreciation for the stories and cultures behind each dish. For me, Chinese food is more than just nourishment—it’s a celebration of flavor, tradition, and togetherness.',
    images: [
      {
        src: '/assets/images/about/photo-hotpot-table-with-dog.webp',
        srcset:
          '/assets/images/about/photo-hotpot-table-with-dog-p-500.webp 500w, /assets/images/about/photo-hotpot-table-with-dog-p-800.webp 800w, /assets/images/about/photo-hotpot-table-with-dog-p-1080.webp 1080w, /assets/images/about/photo-hotpot-table-with-dog-p-1600.webp 1600w, /assets/images/about/photo-hotpot-table-with-dog-p-2000.webp 2000w, /assets/images/about/photo-hotpot-table-with-dog.webp 2268w',
        sizes: '(max-width: 1279px) 100vw, 1120px',
        alt: 'A hotpot dinner spread of sliced meat'
      },
      {
        src: '/assets/images/about/photo-hotpot-spread-kitchen.webp',
        srcset:
          '/assets/images/about/photo-hotpot-spread-kitchen-p-500.webp 500w, /assets/images/about/photo-hotpot-spread-kitchen-p-800.webp 800w, /assets/images/about/photo-hotpot-spread-kitchen-p-1080.webp 1080w, /assets/images/about/photo-hotpot-spread-kitchen.webp 1290w',
        sizes: '(max-width: 1290px) 100vw, 1290px',
        alt: 'A home-cooked hotpot spread with shrimp'
      }
    ]
  },
  {
    title: 'I am passionate of traveling',
    html:
      'I’m a nature enthusiast with an insatiable curiosity for the great outdoors. Whether it’s hiking through rugged trails, diving into the vibrant underwater world, or embarking on journeys to new destinations, I thrive on the thrill of exploration and the beauty of discovering the unknown.<br />These adventures have taught me resilience, mindfulness, and a deep appreciation for the planet’s natural wonders. Whether I’m scaling a mountain, diving beneath the waves, or wandering through a bustling city, I’m always eager to embrace new experiences and share my passion for exploration with others.',
    images: [
      {
        src: '/assets/images/about/photo-jeep-summit-above-clouds.webp',
        srcset:
          '/assets/images/about/photo-jeep-summit-above-clouds-p-500.webp 500w, /assets/images/about/photo-jeep-summit-above-clouds-p-800.webp 800w, /assets/images/about/photo-jeep-summit-above-clouds.webp 1080w',
        sizes: '(max-width: 1279px) 100vw, 1120px',
        alt: 'Woman sitting on the hood of a jeep at a mountain summit above the clouds'
      },
      {
        src: '/assets/images/about/photo-sandstone-canyon-group-photo.webp',
        srcset:
          '/assets/images/about/photo-sandstone-canyon-group-photo-p-500.webp 500w, /assets/images/about/photo-sandstone-canyon-group-photo-p-800.webp 800w, /assets/images/about/photo-sandstone-canyon-group-photo-p-1080.webp 1080w, /assets/images/about/photo-sandstone-canyon-group-photo-p-1600.webp 1600w, /assets/images/about/photo-sandstone-canyon-group-photo-p-2000.webp 2000w, /assets/images/about/photo-sandstone-canyon-group-photo-p-2600.webp 2600w, /assets/images/about/photo-sandstone-canyon-group-photo.webp 3200w',
        sizes: '(max-width: 3024px) 100vw, 3024px',
        alt: 'Three people posing on a striped red sandstone slope, seen from above'
      }
    ]
  }
];
---

<BaseLayout
  title="About — Yanice Yang"
  description="Yanice Yang is a user experience designer in the Bay Area, previously five years in fashion design."
  reveal={true}
  lenis={true}
  chrome={true}
>
  <div class="about-page">
    <header class="about-page__hero">
      <section class="about-page__section">
        <div class="about-page__wide">
          <div class="about-page__hero-row">
            <div class="about-page__col">
              <div class="about-page__place">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M17.3635 8.36364C17.3635 14.0909 9.99987 19 9.99987 19C9.99987 19 2.63623 14.0909 2.63623 8.36364C2.63623 6.41068 3.41204 4.53771 4.79299 3.15676C6.17394 1.77581 8.04691 1 9.99987 1C11.9528 1 13.8258 1.77581 15.2067 3.15676C16.5877 4.53771 17.3635 6.41068 17.3635 8.36364Z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                  <path
                    d="M9.99987 10.8182C11.3555 10.8182 12.4544 9.71924 12.4544 8.36364C12.4544 7.00803 11.3555 5.90909 9.99987 5.90909C8.64426 5.90909 7.54532 7.00803 7.54532 8.36364C7.54532 9.71924 8.64426 10.8182 9.99987 10.8182Z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                Bay Area, US
              </div>

              <div class="about-page__line">
                <p class="about-page__display about-page__display--soft">Hello,</p>
              </div>
              <div class="about-page__line about-page__line--last">
                <h1 class="about-page__display">I&#39;m Yanice Yang</h1>
              </div>

              <p class="about-page__intro">
                I&#8217;m a User Experience Designer based in the Bay Area. I enjoy solving digital
                problems by empathizing, researching, exploring and designing.
              </p>

              <div class="about-page__btns">
                <a
                  class="about-page__btn"
                  href="https://www.linkedin.com/in/yanice-yang"
                  target="_blank"
                  rel="noopener"
                >
                  LinkedIn
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M5.8335 14.1666L14.1668 5.83331M14.1668 5.83331H5.8335M14.1668 5.83331V14.1666"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </a>
              </div>
            </div>

            <div class="about-page__col">
              <div class="about-page__portrait-stack">
                <div class="about-page__portrait">
                  <img
                    width="1120"
                    sizes="(max-width: 1279px) 100vw, 1120px"
                    src="/assets/images/about/illustration-ai-generated-self-avatar.webp"
                    srcset="/assets/images/about/illustration-ai-generated-self-avatar-p-500.webp 500w, /assets/images/about/illustration-ai-generated-self-avatar-p-800.webp 800w, /assets/images/about/illustration-ai-generated-self-avatar.webp 1024w"
                    alt="Stylized cartoon avatar of a smiling young woman with long wavy brown hair"
                  />
                </div>
                <img
                  class="about-page__glow"
                  src="/assets/images/about/bg-aurora-light-accent.png"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    </header>

    <section class="about-page__section">
      <div class="about-page__wide">
        <div class="about-page__col">
          <p class="about-page__p">
            Thanks for stopping by. I am a designer passionate about exploring diverse fields and
            helping users and businesses find a clearer path to success. As a UX designer, I&#8217;ve
            come to deeply appreciate design as a bridge between user needs and business goals. To
            me, UX is not just about visually appealing interfaces&#8212;it is about solving real
            problems in ways that feel intuitive, inclusive, and meaningful. Before becoming a UX
            designer, I was a fashion designer for five years; feel free to check my fashion work
            here. I also enjoy learning math, physics, and other STEM fields.
          </p>

          <h2 class="about-page__h2">Fun Fact</h2>
          <p class="about-page__p">
            I made 100k revenue in 2019 when I run a small business in Fashion field;)
          </p>

          <div class="about-page__btns">
            <a class="about-page__btn" href="/fashion.html">
              Fashion Project
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M5.8335 14.1666L14.1668 5.83331M14.1668 5.83331H5.8335M14.1668 5.83331V14.1666"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-page__section about-page__section--flush">
      <h2 class="about-page__h2 about-page__h2--indent">A little about me</h2>
      <div class="about-page__narrow">
        {
          stories.map((story) => (
            <div class="about-page__story">
              <div class="about-page__story-media">
                {story.images.map((image) => (
                  <img
                    src={image.src}
                    srcset={image.srcset}
                    sizes={image.sizes}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
              <div class="about-page__col">
                <h3 class="about-page__h3">{story.title}</h3>
                <p class="about-page__p" set:html={story.html} />
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
