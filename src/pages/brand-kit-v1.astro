---
/** Brand Kit v1 — structure-only draft.
 *
 * The section rhythm here is borrowed from the Opus Clip case study, but
 * nothing else is: no Webflow markup, no Webflow classes, and none of that
 * project's copy or assets. Everything is composed from the Astro
 * case-study components, because every case is moving to Astro.
 *
 * State: every artwork slot is a MediaPlaceholder and every line of copy is
 * a numbered TODO(Lark) waiting on the source document. Not linked from any
 * navigation and noindex, so it cannot be reached or indexed while empty.
 *
 * Filling this in:
 *   copy  — replace each <p class="todo"> / heading marked TODO(Lark) in the
 *           numbered order below.
 *   art   — swap a <MediaPlaceholder> for <MediaFigure src=… /> (or
 *           <MediaVideo>) in place; the surrounding markup does not change.
 */
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import CaseMetaGrid from '../components/CaseMetaGrid.astro';
import CaseQuote from '../components/CaseQuote.astro';
import CaseSection from '../components/CaseSection.astro';
import CaseStat from '../components/CaseStat.astro';
import MediaGrid from '../components/MediaGrid.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import type { Project } from '../data/projects';

const project: Project = {
  slug: 'brand-kit-v1',
  title: 'Brand Kit',
  href: 'brand-kit-v1.html',
  scope: 'TODO(Lark 02) — scope line',
  note: 'TODO(Lark 03) — one-sentence project note shown under the title.',
  description: 'Brand Kit v1 — structure draft awaiting source copy.',
  status: 'in-progress',
  engine: 'astro',
  kind: 'slot',
  theme: 'dark',
  featuredOnLanding: false,
  featuredOnIndex: false,
  featuredOnProjects: false,
  landingOrder: 98
};
---

<CaseStudyLayout project={project} noindex={true}>
  {/* 04–06 */}
  <CaseMetaGrid
    overview="TODO(Lark 04) — Overview paragraph."
    role="TODO(Lark 05) — Role paragraph."
    timeline="TODO(Lark 06) — Timeline"
  />

  <CaseSection id="introduction" eyebrow="01" title="Introduction">
    <p class="todo">TODO(Lark 07) — Introduction paragraph.</p>
    <MediaPlaceholder label="Introduction — opening artifact" ratio="16 / 9" />
  </CaseSection>

  <CaseSection id="challenge" eyebrow="02" title="The Challenge">
    <p class="todo">TODO(Lark 08) — The Challenge paragraph.</p>
    <MediaPlaceholder label="The Challenge — supporting artifact" ratio="16 / 9" />
  </CaseSection>

  <CaseSection id="design" eyebrow="03" title="Design">
    <div class="case-block">
