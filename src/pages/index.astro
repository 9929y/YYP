---
/**
 * PLACEHOLDER homepage. Proves the content pipeline end to end; every visual
 * decision here is temporary until the Figma UI is implemented.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/islands/Reveal';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');

const featured = (await getCollection('cases', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const { hero } = home.data;
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <section class="mx-auto max-w-6xl px-6 py-24">
    {hero && (
      <>
        <p class="text-sm uppercase tracking-wide text-muted-foreground">{hero.eyebrow}</p>
        <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-tight md:text-6xl">
          <span class="sr-only">{hero.statement.accessible}</span>
          <span aria-hidden="true">
            {hero.statement.lead} beyond {hero.statement.pairs[0].beyond} toward {hero.statement.pairs[0].toward}
          </span>
        </h1>
        <p class="mt-6 text-muted-foreground">{hero.meta.join(' · ')}</p>
      </>
    )}
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24" aria-labelledby="featured">
    <h2 id="featured" class="text-sm uppercase tracking-wide text-muted-foreground">{home.data.featuredLabel}</h2>
    <ul class="mt-8 grid gap-12">
      {featured.map((entry, i) => (
        <li>
          <Reveal client:visible delay={i * 0.05}>
            <article class="grid gap-6 md:grid-cols-[1fr_2fr]">
              <div>
                {entry.data.logo && (
                  <img src={entry.data.logo.src} alt={entry.data.logo.alt} width={entry.data.logo.width} height={entry.data.logo.height} loading="lazy" class="h-6 w-auto" />
                )}
                <h3 class="mt-4 text-2xl font-medium">
                  {entry.data.status === 'published' ? (
                    <a href={`/work/${entry.data.slug}`}>{entry.data.headline ?? entry.data.title}</a>
                  ) : (
                    <span>{entry.data.headline ?? entry.data.title}</span>
                  )}
                </h3>
                <p class="mt-1 text-sm text-muted-foreground">{entry.data.scope}</p>
                <p class="mt-4 text-muted-foreground">{entry.data.note}</p>
                {entry.data.status !== 'published' && <p class="mt-2 text-xs uppercase text-muted-foreground">In progress</p>}
              </div>
              {entry.data.video ? (
                <video
                  class="w-full rounded-xl border"
                  src={entry.data.video.src}
                  poster={entry.data.video.poster}
                  width={entry.data.video.width}
                  height={entry.data.video.height}
                  muted
                  loop
                  playsinline
                  autoplay
                  aria-label={entry.data.video.label}
                ></video>
              ) : entry.data.cover ? (
                <img class="w-full rounded-xl border" src={entry.data.cover.src} alt={entry.data.cover.alt} width={entry.data.cover.width} height={entry.data.cover.height} loading="lazy" />
              ) : null}
            </article>
          </Reveal>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
