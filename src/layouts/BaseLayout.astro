---
import '@/styles/global.css';
import nav from '@/content/site/navigation.json';

interface Props {
  title: string;
  description?: string;
  /** The site stays out of search indexes until the relaunch is approved. */
  noindex?: boolean;
}

const { title, description, noindex = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/images/ui/logo-site-favicon.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/assets/images/ui/logo-site-app-icon.webp" />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!--
      PLACEHOLDER CHROME. The real nav/footer come from the Figma UI.
      Content (labels, links) is data in src/content/site/navigation.json.
    -->
    <header class="border-b">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 text-sm" aria-label="Main">
        <a href={nav.brand.href} class="font-medium">{nav.brand.label}</a>
        <ul class="flex gap-6">
          {nav.primary.map((item) => (
            <li><a href={item.href} class="text-muted-foreground hover:text-foreground">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6 text-sm text-muted-foreground">
        <p>{nav.footer.credit}</p>
        <ul class="flex gap-4">
          {nav.social.map((item) => (
            <li><a href={item.href} rel="noopener" target={item.href.startsWith('http') ? '_blank' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>
