---
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  htmlClass?: string;
  reveal?: boolean;
  lenis?: boolean;
  chrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Product designer. Selected work in research, consumer product, enterprise and health.',
  htmlClass = '',
  reveal = false,
  lenis = true,
  chrome = true,
  noindex = false
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;

/* The hand-managed assets/ layer is served under stable, unhashed names, so a
   browser can hold a stale copy of one file while receiving page CSS that
   depends on the new one. `?v=` moves the whole set to a new URL whenever any
   of it changes, which is the only thing that bypasses a cache entry that is
   still "fresh" under the header it was served with. Set by
   scripts/assets-passthrough.mjs. */
const v = import.meta.env.PUBLIC_ASSET_V;
const q = v ? `?v=${v}` : '';
const documentClass = [htmlClass, chrome ? 'yy-chrome' : ''].filter(Boolean).join(' ');
---
<!DOCTYPE html>
<html lang="en" class={documentClass}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link href="/assets/images/ui/logo-site-favicon.webp" rel="shortcut icon" type="image/x-icon" />
    <link href="/assets/images/ui/logo-site-app-icon.webp" rel="apple-touch-icon" />
    <style is:inline>
      /* Anti-flash rules, lifted from yy-chrome.js so the chrome script can defer.
         Must stay equivalent to the boot rules in yy-chrome.js — check-site
         asserts both halves. */
      html.yy-chrome { scrollbar-gutter: stable }
      html.yy-panel-open, html.yy-panel-open body { overflow: hidden !important }
    </style>
    <link rel="preload" href="/assets/fonts/plus-jakarta-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/plus-jakarta-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link href={`/assets/css/yy-tokens.css${q}`} rel="stylesheet" type="text/css" />
    <link href={`/assets/css/yy-motion.css${q}`} rel="stylesheet" type="text/css" />
    {chrome && (
      <>
        <link href={`/assets/css/yy-chrome.css${q}`} rel="stylesheet" type="text/css" />
        <link href={`/assets/css/yy-cursor.css${q}`} rel="stylesheet" type="text/css" />
      </>
    )}
    <slot name="head" />
    {chrome && <script is:inline defer src={`/assets/js/yy-chrome.js${q}`}></script>}
    {reveal && <script is:inline defer src={`/assets/js/yy-reveal.js${q}`}></script>}
    {lenis && (
      <>
        <link href={`/assets/css/lenis.css${q}`} rel="stylesheet" type="text/css" />
        <script is:inline defer src={`/assets/js/lenis.min.js${q}`}></script>
        <script is:inline defer src={`/assets/js/yy-scroll.js${q}`}></script>
      </>
    )}
  </head>
  <body>
    <slot />
    <slot name="scripts" />
  </body>
</html>
