---
interface Props {
  title: string;
  description?: string;
  htmlClass?: string;
  reveal?: boolean;
  lenis?: boolean;
  chrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Product designer. Selected work in research, consumer product, enterprise and health.',
  htmlClass = '',
  reveal = false,
  lenis = true,
  chrome = true,
  noindex = false
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const documentClass = [htmlClass, chrome ? 'yy-chrome' : ''].filter(Boolean).join(' ');
---
<!DOCTYPE html>
<html lang="en" class={documentClass}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link href="/assets/images/ui/logo-site-favicon.webp" rel="shortcut icon" type="image/x-icon" />
    <link href="/assets/images/ui/logo-site-app-icon.webp" rel="apple-touch-icon" />
    <style is:inline>
      /* Anti-flash rules, lifted from yy-chrome.js so the chrome script can defer.
         Must stay byte-equivalent to the boot rules in yy-chrome.js. */
      html.yy-chrome { scrollbar-gutter: stable }
      html.yy-chrome .navbar.w-nav { display: none }
      html.yy-chrome .footer-credit-wrapper { display: none }
      html.yy-panel-open, html.yy-panel-open body { overflow: hidden !important }
      html.yy-chrome .footer-section:not(:has(.four-column)) { display: none }
      html.yy-chrome .grid-wrapper:has(> .footer-credit-wrapper):not(:has(.four-column)) { display: none }
      html.yy-chrome .footer-section { border-top: none; padding-top: 48px; padding-bottom: 0 }
      .preloader-lark { display: none !important }
    </style>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link href="/assets/css/yy-tokens.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/yy-motion.css" rel="stylesheet" type="text/css" />
    {chrome && (
      <>
        <link href="/assets/css/yy-chrome.css" rel="stylesheet" type="text/css" />
        <link href="/assets/css/yy-cursor.css" rel="stylesheet" type="text/css" />
      </>
    )}
    <slot name="head" />
    {chrome && <script is:inline defer src="/assets/js/yy-chrome.js"></script>}
    {reveal && <script is:inline defer src="/assets/js/yy-reveal.js"></script>}
    {lenis && (
      <>
        <link href="/assets/css/lenis.css" rel="stylesheet" type="text/css" />
        <script is:inline defer src="/assets/js/lenis.min.js"></script>
        <script is:inline defer src="/assets/js/yy-scroll.js"></script>
      </>
    )}
  </head>
  <body>
    <slot />
    <slot name="scripts" />
  </body>
</html>
