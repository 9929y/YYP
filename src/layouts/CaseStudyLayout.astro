---
import BaseLayout from './BaseLayout.astro';
import CaseStudyNav from '../components/CaseStudyNav.astro';
import type { Project } from '../data/projects';
import { neighbors, publicUrl } from '../data/projects';
import '../styles/case-study.css';

interface Props {
  project: Project;
  noindex?: boolean;
}

const { project, noindex = false } = Astro.props;
const { prev, next } = neighbors(project.slug);
const description = project.description ?? project.note;
const htmlClass = project.theme === 'dark' ? 'yy-case yy-case--dark' : 'yy-case';
const ogImage = project.cover
  ? new URL(publicUrl(project.cover.src), Astro.site ?? 'https://www.yaniceyang.com').href
  : undefined;
---
<BaseLayout
  title={`${project.title} — Yanice Yang`}
  description={description}
  htmlClass={htmlClass}
  reveal={true}
  lenis={true}
  chrome={true}
  noindex={noindex}
>
  <Fragment slot="head">
    <meta property="og:title" content={`${project.title} — Yanice Yang`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </Fragment>

  <main class="cs" data-theme={project.theme}>
    <header class="cs__hero">
      <p class="cs__eyebrow">Case study</p>
      <div>
        <h1 class="cs__title rv">{project.title}</h1>
        <p class="cs__scope rv">{project.scope}</p>
        <p class="cs__note rv">{project.note}</p>
      </div>
    </header>
    <div class="cs__body">
      <slot />
    </div>
    <CaseStudyNav prev={prev} next={next} />
  </main>
</BaseLayout>
